# apps/api
PORT=3001
TRANSMI_RT_BASE=https://gtfs.transmilenio.gov.co
# El feed se regenera cada ~26 s
POLL_INTERVAL_MS=30000
# Lista separada por comas. Se aceptan regex entre barras, p. ej. /^https:\/\/([a-z0-9-]+\.)?bus-tracking\.pages\.dev$/
CORS_ORIGIN=http://localhost:3000
# Detrás de un proxy (Render): "true", número de saltos o lista de IPs/CIDR. Vacío en local.
TRUST_PROXY=
# Header con la IP real del cliente para el rate limit (en Render: cf-connecting-ip). Vacío en local.
CLIENT_IP_HEADER=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
